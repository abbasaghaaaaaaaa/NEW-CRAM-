<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center"
    android:padding="8dp"
    android:elevation="4dp"
    android:background="?attr/colorSurface">

    <Button
        android:id="@+id/btn_card_mode"
        style="@style/Widget.FlashcardApp.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/mode_card" />

    <Button
        android:id="@+id/btn_memorize_mode"
        style="@style/Widget.FlashcardApp.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/mode_memorize" />

    <Button
        android:id="@+id/btn_cram_mode"
        style="@style/Widget.FlashcardApp.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/mode_cram" />

    <Button
        android:id="@+id/btn_quick_mode"
        style="@style/Widget.FlashcardApp.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/mode_quick" />

    <Button
        android:id="@+id/btn_test_mode"
        style="@style/Widget.FlashcardApp.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/mode_test" />

</LinearLayout>